# Base de datos (Supabase / Prisma 7)
DATABASE_URL=
DIRECT_URL=

NODE_ENV=development

# Auth
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=

# Mongo (refresh tokens, Spotify OAuth state)
MONGOOSE_PASSWORD=
MONGOOSE_DB_NAME=

# Groq (extracción de canciones, spec 01)
GROQ_API_KEY=
GROQ_VISION_MODEL=

# Frontend
FRONTEND_URL=http://localhost:5173

# Spotify OAuth (spec 02)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/spotify/callback
SPOTIFY_TOKEN_ENC_KEY=
